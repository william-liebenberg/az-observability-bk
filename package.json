{
  "name": "azure-observability-coffee-demo",
  "version": "1.0.0",
  "description": "Azure Functions TypeScript demo for Azure observability deep dives using Service Bus, Application Insights, Cosmos DB, and Blob Storage.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "start": "npm run build && func start",
    "test": "npm run build && node --test dist/test/orders.test.js",
    "watch": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.16.2",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.33.0",
    "applicationinsights": "^2.9.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true
  }
}
